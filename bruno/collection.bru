auth {
  mode: none
}

docs {
  myrag — RAG demo endpoints.
  1. Select the "Local" environment (top-right dropdown).
  2. Run "Ingest Sample" first to seed pgvector.
  3. Run the Search requests (retrieval only, no LLM).
  4. Run "Ask (RAG)" for the full loop — grounded answer + sources (needs DEEPSEEK_API_KEY in .env).
}
